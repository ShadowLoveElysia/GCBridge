    "启动 GC_Bridge.cmd",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "mcp": "bun src/cli.ts mcp",
    "check": "bun scripts/check.ts",
    "lint": "bun scripts/check.ts lint",
    "format": "bun scripts/check.ts format",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "19.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oh-my-pi/pi-ai": "19.1.1",
    "@oh-my-pi/pi-catalog": "19.1.1",
    "zod": "4.3.6",
    "@oh-my-pi/pi-natives": "19.1.1"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.1.1",
    "@biomejs/biome": "2.4.8",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=19.1.1 <20"
  },
