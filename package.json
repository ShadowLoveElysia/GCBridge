{
  "name": "gc-bridge",
  "version": "0.3.0",
  "description": "Creative direction for coding agents, powered by Oh My Pi",
  "type": "module",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "gc-bridge": "./src/cli.ts"
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "files": [
    "src",
    "ui",
    "skills",
    "launch.sh",
